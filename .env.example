# Kopiraj u .env.local i upiši vlastite vrijednosti (Neon baza, Anthropic ključ; vidi docs/RAZVOJ.md). Članovi tima ih dobiju od Leona. .env.local nikad u git.

# Neon Postgres: Dashboard > Connection Details > pooled connection string (Frankfurt)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Claude (AI SDK). Samo na poslužitelju.
ANTHROPIC_API_KEY=""

# 0 = pravi API (src/lib/client.ts); bilo koja druga vrijednost ili prazno prikazuje lažne podatke iz src/lib/mock.ts (zadano bez ove varijable)
NEXT_PUBLIC_USE_MOCK=0

# Demo igra (scripts/seed-demo.ts): kod igre (6 znakova) i profesorski kod (12 znakova)
DEMO_JOIN_CODE=""
DEMO_PROF_CODE=""
# E-pošta demo profesorskog računa. Igre tog računa i igra s DEMO_JOIN_CODE ne mogu se obrisati kroz aplikaciju (ADR-060): postavi je i na poslužitelju.
DEMO_PROF_EMAIL=""

# Better Auth (profesorski računi). Tajna: openssl rand -base64 32. URL: http://localhost:3000 lokalno, produkcijski URL na Vercelu.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# AI davatelj i modeli (docs/AI-POTROSNJA.md). Prazno = Claude kao i dosad. Vrijednosti: anthropic | groq | mistral
AI_PROVIDER=
# Po poslu: CHARACTER = lik i agencija, JUDGE = sudac, MENTOR = mentor i prijedlog situacije. Prazno = AI_PROVIDER
AI_PROVIDER_CHARACTER=
AI_PROVIDER_JUDGE=
AI_PROVIDER_MENTOR=
# Model po poslu. Prazno = zadani model davatelja
AI_MODEL_CHARACTER=
AI_MODEL_JUDGE=
AI_MODEL_MENTOR=
# Ključevi drugih davatelja. Samo na poslužitelju.
GROQ_API_KEY=
MISTRAL_API_KEY=
# 1 = Groq besplatni (Free) plan: u zapisu je trošak 0, a cijena po cjeniku ostaje u posebnom stupcu. Samo na besplatnom planu, ne na plaćenom Developer planu
AI_GROQ_FREE=
