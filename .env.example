# Kopiraj u .env.local i upiši vrijednosti (dobiješ ih od Leona). .env.local nikad u git.

# Neon Postgres: Dashboard > Connection Details > pooled connection string (Frankfurt)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Claude (AI SDK). Samo na poslužitelju.
ANTHROPIC_API_KEY=""

# Prazno ili bilo što osim 0 = sučelje radi na lažnim podacima iz src/lib/mock.ts (zadano); 0 = pravi API (src/lib/client.ts)
NEXT_PUBLIC_USE_MOCK=""

# Demo igra (scripts/seed-demo.ts): kod igre (6 znakova) i profesorski kod (12 znakova)
DEMO_JOIN_CODE=""
DEMO_PROF_CODE=""

# Better Auth (profesorski računi, L16). Tajna: openssl rand -base64 32. URL: http://localhost:3000 lokalno, produkcijski URL na Vercelu.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
