# Kopiraj u .env.local i upiši vlastite vrijednosti (Neon baza, Anthropic ključ; vidi docs/RAZVOJ.md). Članovi tima ih dobiju od Leona. .env.local nikad u git.

# Neon Postgres: Dashboard > Connection Details > pooled connection string (Frankfurt)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Claude (AI SDK). Samo na poslužitelju.
ANTHROPIC_API_KEY=""

# 0 = pravi API (src/lib/client.ts); bilo koja druga vrijednost ili prazno prikazuje lažne podatke iz src/lib/mock.ts (zadano bez ove varijable)
NEXT_PUBLIC_USE_MOCK=0

# Demo igra (scripts/seed-demo.ts): kod igre (6 znakova) i profesorski kod (12 znakova)
DEMO_JOIN_CODE=""
DEMO_PROF_CODE=""

# Better Auth (profesorski računi). Tajna: openssl rand -base64 32. URL: http://localhost:3000 lokalno, produkcijski URL na Vercelu.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
